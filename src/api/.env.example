# Chỉ dùng cho máy phát triển. Hãy thay DJANGO_SECRET_KEY và đặt DJANGO_DEBUG=false khi triển khai.
DJANGO_SECRET_KEY=development-only-change-this-before-deployment
DJANGO_DEBUG=true
API_DOCS_ENABLED=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=false

# Next.js dev server. Có thể khai báo nhiều origin, phân tách bằng dấu phẩy.
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Email tài khoản và đặt lại mật khẩu qua Gmail SMTP (587 + STARTTLS).
# Nếu App Password cũ đã bị lộ, hãy thu hồi rồi tạo mới; không dùng App Password
# làm Google OAuth Client Secret. Điền ba biến địa chỉ/mật khẩu gửi trong .env cục bộ.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
EMAIL_TIMEOUT=10
ADMIN_SMALL_TEMP_PASSWORD=
TEACHER_INITIAL_PASSWORD=
STUDENT_INITIAL_PASSWORD=
WEB_APP_BASE_URL=http://localhost:3001
PASSWORD_RESET_TIMEOUT=120
ACCOUNT_ACTIVATION_TIMEOUT=86400

# SePay bank-transfer QR. Keep disabled until API webhook, database migrations,
# and a public HTTPS webhook URL have been configured and verified.
SEPAY_ENABLED=false
SEPAY_BANK_CODE=
SEPAY_BANK_ACCOUNT=
SEPAY_WEBHOOK_SECRET=
SEPAY_PAYMENT_CODE_PREFIX=TT
SEPAY_PAYMENT_TTL_SECONDS=900

# Để {} đến khi cấu hình thông tin kết nối SQL Server cho từng site.
# Ví dụ cấu trúc (không đặt mật khẩu thật trong file được commit):
# {"Q1":{"name":"QLTTNN_Q1","host":"10.0.0.10","port":1433,"user":"api_user","password":"..."}}
SITE_DATABASES_JSON={}
# Mã site đang giữ riêng phiên bảo mật của API; không chứa dữ liệu nghiệp vụ tổng hợp.
AUTH_SESSION_SITE_CODE=
SQL_SERVER_DRIVER=ODBC Driver 18 for SQL Server
SQL_SERVER_ENCRYPT=yes
# Chỉ bật TrustServerCertificate trong môi trường local có chứng chỉ tự ký.
SQL_SERVER_TRUST_SERVER_CERTIFICATE=yes

# Cloudinary secrets: chỉ đặt trong src/api/.env (đã bị Git bỏ qua), không commit.
# Nếu API secret từng bị chia sẻ, hãy rotate rồi mới cấu hình giá trị mới ở đây.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=replace-with-rotated-secret
CLOUDINARY_ROOT_FOLDER=language-center-management

# Google/Facebook only support students after first password change and explicit linking.
# Register these exact callback URLs in each provider app. Keep secrets out of Next.js/Git.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8001/api/v1/auth/oauth/google/callback/

FACEBOOK_OAUTH_APP_ID=
FACEBOOK_OAUTH_APP_SECRET=
FACEBOOK_OAUTH_REDIRECT_URI=http://localhost:8001/api/v1/auth/oauth/facebook/callback/
FACEBOOK_GRAPH_API_VERSION=v26.0
OAUTH_WEB_RETURN_URL=http://localhost:3001
