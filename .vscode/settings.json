{
  "terminal.integrated.cwd": "${workspaceFolder}",
  "terminal.integrated.profiles.windows": {
    "Command Prompt (auto .venv on cd)": {
      "path": "${env:windir}\\System32\\cmd.exe",
      "args": [
        "/K",
        "doskey cd=cd $* $T if exist .venv\\Scripts\\activate.bat if not defined VIRTUAL_ENV call .venv\\Scripts\\activate.bat"
      ],
      "icon": "terminal-cmd"
    }
  },
  "terminal.integrated.defaultProfile.windows": "Command Prompt (auto .venv on cd)",
  "python.defaultInterpreterPath": "${workspaceFolder}/src/api/.venv/Scripts/python.exe",
  "python.terminal.activateEnvironment": false,
  "python-envs.terminal.autoActivationType": "off"
}
